{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nerdspacelabsdashboard",
  "main": "./worker.js",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TWITCH_CLIENT_ID": "1ttjf7d3zcz71caav9zg9mf2x6uj18"
  }
}